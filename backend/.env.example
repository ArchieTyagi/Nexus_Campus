PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexus_campus
JWT_SECRET=put-a-long-random-string-here
JWT_EXPIRES_IN=7d
# The frontend site(s) allowed to call this backend. Online, list both, separated by a comma:
# CLIENT_URL=https://your-site.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Online only: how many hosting servers sit in front of the app (see /api/health "ip"). Leave out locally.
# TRUST_PROXY=1

# Used once by: npm run seed
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=change-me-123
